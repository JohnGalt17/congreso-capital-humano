{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/voto", "destination": "/voto/index.html" },
    { "source": "/invitados", "destination": "/invitados/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}